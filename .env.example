# Copia este archivo a .env (la API lo carga solo fuera de producción).
NODE_ENV=development
HOST=127.0.0.1
PORT=4100
LOG_LEVEL=info

# PostgreSQL local (docker compose up -d). El puerto 5433 evita choques
# con otros PostgreSQL que ya corran en tu máquina.
DATABASE_URL=postgres://centinela:centinela@localhost:5433/centinela

# Motor de checks embebido en la API.
WORKER_ENABLED=true
WORKER_TICK_MS=1000
WORKER_BATCH_SIZE=10
WORKER_CONCURRENCY=5

# Guarda SSRF: en true permite vigilar destinos en rangos privados
# (solo para desarrollo local; jamás en producción).
ALLOW_PRIVATE_TARGETS=false

# Firma de los tokens de acceso (JWT HS256) y duración de las sesiones.
# Genera un secreto propio con:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=secreto-de-ejemplo-cambia-esto-por-uno-propio-32
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_DAYS=30

# Intentos de inicio de sesión permitidos por minuto (por IP y correo).
LOGIN_ATTEMPTS_PER_MINUTE=10

# Límites de peticiones por IP y minuto (0 desactiva cada tope).
# El general cubre /api; el público protege status/badges/embed/fuentes;
# el de latidos es por token (un monitor no se deja inundar).
RATE_LIMIT_PER_MINUTE=600
PUBLIC_RATE_LIMIT_PER_MINUTE=300
HEARTBEAT_LIMIT_PER_MINUTE=120

# Cada cuántas horas se revisa el certificado TLS de los monitores https.
SSL_RECHECK_HOURS=24

# Avisos por email vía Resend (opcionales; sin claves, el canal email queda
# en error controlado en vez de romper el worker).
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=Centinela <avisos@tudominio.com>
